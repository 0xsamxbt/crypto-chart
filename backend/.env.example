PORT=4000
CORS_ORIGIN=http://localhost:5173

# Binance (use https://api.binance.us if api.binance.com is blocked in your region)
BINANCE_BASE_URL=https://api.binance.com

# MongoDB (shared cache for all users)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=crypto_chart

# How long the live (still-open) candle / 24h ticker is shared between ALL users
# before Binance is asked again. Closed candles are never fetched twice.
KLINE_LIVE_TTL_MS=1000
TICKER_TTL_MS=1500
